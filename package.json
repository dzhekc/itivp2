{
  "name": "lab",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "docker:db:up": "docker compose up -d postgres",
    "docker:db:down": "docker compose down",
    "db:migrate": "sequelize-cli db:migrate",
